# Fecha de inicio por defecto de la extracción
START_DATE=2026-01-01
DATA_DIR=./data

# Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Refresh token inicial; tras el primer uso se guarda el rotado en data/tokens/strava.json
STRAVA_REFRESH_TOKEN=

# Garmin Connect Personal API key
# Créala en https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=
# Pausa mínima entre peticiones a Garmin (segundos)
GARMIN_MIN_INTERVAL=1.0
